rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Profilo utente: solo il proprietario
    match /users/{userId} {
      allow read: if signedIn() && uid() == userId;
      allow create: if signedIn() && uid() == userId;
      allow update: if signedIn() && uid() == userId;
      allow delete: if false;
    }

    // Famiglia
    // - lettura: utenti autenticati (serve per cercare il codice invito)
    // - create: solo il creatore, che deve essere tra i members
    // - update: membri esistenti, OPPURE join (aggiungere se stessi a members)
    match /families/{familyId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == uid()
        && uid() in request.resource.data.members;

      allow update: if signedIn() && (
        // membro già presente: può aggiornare
        uid() in resource.data.members
        ||
        // join: può solo modificare "members" e deve includere se stesso
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && uid() in request.resource.data.members
        )
      );

      allow delete: if signedIn() && uid() == resource.data.createdBy;
    }

    match /notes/{noteId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == uid()
        && request.resource.data.keys().hasAll(['familyId', 'content', 'authorId', 'createdAt']);
      allow update: if signedIn() && resource.data.authorId == uid();
      allow delete: if signedIn() && resource.data.authorId == uid();
    }

    match /deadlines/{deadlineId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == uid()
        && request.resource.data.keys().hasAll(['familyId', 'title', 'dueDate', 'authorId', 'createdAt']);
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.authorId == uid();
    }

    match /categories/{catId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['familyId', 'name', 'path', 'createdAt']);
      allow update: if signedIn();
      allow delete: if signedIn();
    }

    match /documents/{docId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uploadedBy == uid()
        && request.resource.data.keys().hasAll(['familyId', 'name', 'path', 'createdAt']);
      allow update: if signedIn();
      allow delete: if signedIn();
    }

    // Subscription push (scritte via Admin SDK lato server; lettura solo propria)
    match /pushSubscriptions/{id} {
      allow read: if signedIn() && resource.data.userId == uid();
      allow write: if false;
    }
  }
}
