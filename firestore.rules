rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Profilo utente: solo il proprietario
    match /users/{userId} {
      allow read: if signedIn() && uid() == userId;
      allow create: if signedIn() && uid() == userId;
      allow update: if signedIn() && uid() == userId;
      allow delete: if false;
    }

    // Famiglia: membri possono leggere; create autenticati; update solo membri
    match /families/{familyId} {
      allow read: if signedIn() &&
        (uid() in resource.data.members || uid() == resource.data.createdBy);
      allow create: if signedIn()
        && request.resource.data.createdBy == uid()
        && uid() in request.resource.data.members;
      allow update: if signedIn() && uid() in resource.data.members;
      allow delete: if signedIn() && uid() == resource.data.createdBy;
    }

    // Note (post-it): chiunque autenticato della stessa familyId (controllo soft lato client;
    // in produzione si può stringere leggendo la family)
    match /notes/{noteId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == uid()
        && request.resource.data.keys().hasAll(['familyId', 'content', 'authorId', 'createdAt']);
      allow update: if signedIn() && resource.data.authorId == uid();
      allow delete: if signedIn() && resource.data.authorId == uid();
    }

    match /deadlines/{deadlineId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == uid()
        && request.resource.data.keys().hasAll(['familyId', 'title', 'dueDate', 'authorId', 'createdAt']);
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.authorId == uid();
    }

    match /categories/{catId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['familyId', 'name', 'path', 'createdAt']);
      allow update: if signedIn();
      allow delete: if signedIn();
    }

    match /documents/{docId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uploadedBy == uid()
        && request.resource.data.keys().hasAll(['familyId', 'name', 'path', 'createdAt']);
      allow update: if signedIn();
      allow delete: if signedIn();
    }
  }
}
